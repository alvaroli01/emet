# Copy to .env.local (local) and add the same values in Vercel → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API. Both are free.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only (never prefix with NEXT_PUBLIC_). Used to send invites from the Team page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
